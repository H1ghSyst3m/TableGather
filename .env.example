# Copy this file to .env for local defaults or .env.production.local for production secrets.
# npm run server:start loads .env, .env.local, .env.production, then .env.production.local.
# Existing process environment variables still take precedence over values from these files.

# Production mode enables built-in dist/ serving by default.
# NODE_ENV=production

# Room server port. PORT takes precedence when both are set.
TABLEGATHER_PORT=8787
# PORT=8787

# Enables the protected /admin room overview API.
# Open the admin UI with /admin#token=<this-token> once; the client stores it in sessionStorage.
TABLEGATHER_ADMIN_TOKEN=change-me-admin-token

# Serves the built frontend from dist/ through the room server.
# Defaults to true when NODE_ENV=production and false otherwise.
# TABLEGATHER_SERVE_STATIC=true

# Browser WebSocket endpoint override.
# Accepts ws://, wss://, http://, or https://. HTTP(S) values are converted to WS(S).
# Leave empty in production to use the same-origin /ws endpoint behind your reverse proxy.
# Leave empty in development to use ws://<current-hostname>:8787/ws.
VITE_WS_URL=
